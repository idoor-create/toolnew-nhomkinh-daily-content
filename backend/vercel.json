{
  "crons": [
    {
      "path": "/api/cron/daily-content",
      "schedule": "0 1 * * *"
    }
  ],
  "buildCommand": "npx prisma generate && npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
